    //    \find( ==> \modality{#allmodal}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
    //    \replacewith( ==> {tracer.Trace.index := tracer.Trace.index+1}
    //        \modality{#allmodal}{.. #s1 ...}\endmodality (post))
    //    \add(#se = FALSE ==>)
    //    \heuristics(retrace)
