\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \program Type #t;
    \program Expression #e, #e0, #e1, #e2;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program SimpleJavaBooleanExpression #seBool, #seBool0, #seBool1, #seBool2;
    \program NonSimpleExpression #nse, #nse0, #nse1, #nse2;
    \program Statement #s0, #s1, #s2;
    \program LeftHandSide #lhs;
    \program Variable #v, #v0, #v1, #a;
    \formula post;
    \term int idx, idx0;
    \program StringLiteral #methodId;
    \program ArrayLength #length;
    \program JavaLongExpression #seLong;
    \program JavaCharByteShortIntExpression #seCharByteShortInt, #seCharByteShortInt0, #seCharByteShortInt1;

    \program MethodName #mn;
    \program [list] SimpleExpression #selist;
    \program [list] Statement #slist, #slist1;
    \program [list] Catch #cs;
}

\rules(programRules:Java, tracing:on) {

    /*
     * Short circuit rules that don't interfere with if/else tracing
     * [they don't translate to if (*) * else *, only to JavaDL \if(*) \then (*) \else (*)]
     */
    compound_assignment_3_nonsimple_new {
        \find(\modality{#allmodal}{.. #lhs=#nse0 && #nse1; ...}\endmodality (post))

        \varcond(\new(#v0, boolean))
        \replacewith(\modality{#allmodal}{.. boolean #v0 = #nse0;
                #lhs = #v0 && #nse1; ...}\endmodality (post))

        \heuristics(simplify_expression)
        \displayname "compound_assignment"
    };

    compound_assignment_3_reverse_mixed {
        \find(\modality{#allmodal}{.. #lhs=#seBool0 && #nse1; ...}\endmodality (post))

        \replacewith(
            \if(#seBool0 = TRUE)
            \then(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
            \else({#lhs := FALSE}\modality{#allmodal}{.. ...}\endmodality (post))
        )

        \heuristics(simplify_expression)
        \displayname "assignment_and"
    };

    compound_assignment_5_nonsimple_new {
        \find(\modality{#allmodal}{.. #lhs=#nse0 || #nse1; ...}\endmodality (post))

        \varcond(\new(#v0, boolean))
        \replacewith(\modality{#allmodal}{.. boolean #v0 = #nse0;
                #lhs = #v0 || #nse1; ...}\endmodality (post))

        \heuristics(simplify_expression)
        \displayname "compound_assignment"
    };

    compound_assignment_5_reverse_mixed {
        \find(\modality{#allmodal}{.. #lhs=#seBool0 || #nse1; ...}\endmodality (post))

        \replacewith(
            \if(#seBool0 = TRUE)
            \then({#lhs := TRUE}\modality{#allmodal}{.. ...}\endmodality (post))
            \else(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
        )

        \heuristics(simplify_expression)
        \displayname "assignment_or"
    };

    condition_mixed_left {
        \find(\modality{#allmodal}{.. #lhs = #se0 ? #nse1 : #se2; ...}\endmodality (post))

        \replacewith(
            \if(#se0 = TRUE)
            \then(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
            \else({#lhs := #se2}\modality{#allmodal}{.. ...}\endmodality (post))
        )

        \heuristics(simplify_prog)
        \displayname "condition"
    };

    condition_mixed_right {
        \find(\modality{#allmodal}{.. #lhs = #se0 ? #se1 : #nse2; ...}\endmodality (post))

        \replacewith(
            \if(#se0 = TRUE)
            \then({#lhs := #se1}\modality{#allmodal}{.. ...}\endmodality (post))
            \else(\modality{#allmodal}{.. #lhs = #nse2; ...}\endmodality (post))
        )

        \heuristics(simplify_prog)
        \displayname "condidion"
    };

    condition_mixed {
        \find(\modality{#allmodal}{.. #lhs = #se0 ? #nse1 : #nse2; ...}\endmodality (post))

        \replacewith(
            \if(#se0 = TRUE)
            \then(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
            \else(\modality{#allmodal}{.. #lhs = #nse2; ...}\endmodality (post))
        )

        \heuristics(simplify_prog)
        \displayname "condition"
    };

    assignment_array2 {
          \find(\modality{#allmodal}{.. #v = #v0[#se]; ...}\endmodality (post))
          \varcond(\hasElementarySort(#v0, G))
          \replacewith(\modality{#allmodal}{..
                  if(#v0 == null) {
                      throw new java.lang.NullPointerException();
                  }
                  if (#se < 0 || #se >= @(#length-reference(#v0))) {
                      throw new java.lang.ArrayIndexOutOfBoundsException();
                  }
                  @(#v = #v0[#se]);
                  ...}\endmodality (post))
          \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_array2_checked {
        \find(\modality{#allmodal}{.. @(#v = #v0[#se]); ...}\endmodality (post))
        \varcond(\hasElementarySort(#v0, G))
        \replacewith({#v := select<[G]>(heap, #v0, arr(#se))}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_write_attribute {
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \varcond(\not \static(#a), \not \isThisReference(#v))
        \replacewith( ==> \modality{#allmodal}{..
                if(#v == null) {
                    throw new java.lang.NullPointerException();
                }
                @(#v.#a=#se);
                ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assignment"
    };

    assignment_write_attribute_checked {
        \find( ==> \modality{#allmodal}{.. @(#v.#a=#se); ...}\endmodality (post))
        \replacewith( ==> {heap := store(heap, #v, #memberPVToField(#a), #se)}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assignment"
    };

    assignment_read_attribute {
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post))
        \varcond(
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isThisReference(#v))
        \replacewith( ==> \modality{#allmodal}{..
                if (#v == null) {
                    throw new java.lang.NullPointerException();
                }
                @(#v0 = #v.#a);
        ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_read_attribute_checked {
        \find( ==> \modality{#allmodal}{.. @(#v0 = #v.#a); ...}\endmodality (post))
        \varcond(\hasElementarySort(#v0, G))
        \replacewith( ==> {#v0 := select<[G]>(heap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_read_length {
        \find(\modality{#allmodal}{.. #v0 = #v.#length; ...}\endmodality (post))
        \varcond(\not \isThisReference(#v))
        \replacewith(\modality{#allmodal}{..
                if (#v == null) {
                    throw new java.lang.NullPointerException();
                }
                #v0 = @(#v.#length);
        ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_read_length_checked {
        \find(\modality{#allmodal}{.. #v0 = @(#v.#length); ...}\endmodality (post))
        \replacewith({#v0 := length(#v)}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    // TODO die extra Klammer um #v entsteht beim assignment_to_reference_array_component und assignment_array2 index check
    assignment_read_length_checked2 {
        \find(\modality{#allmodal}{.. #v0 = @((#v).#length); ...}\endmodality (post))
        \replacewith({#v0 := length(#v)}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    // TODO improve handling of condition of ArrayStoreException
    assignment_to_reference_array_component {
        \schemaVar \modalOperator {diamond, box} #normal;
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \varcond(\isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                if(#v == null) {
                    throw new java.lang.NullPointerException();
                }
                if (#se < 0 || #se >= @(#length-reference(#v))) {
                    throw new java.lang.ArrayIndexOutOfBoundsException();
                }
                if (false) {
                    throw new java.lang.ArrayStoreException();
                }
                #v[#se]=@(#se0);
                ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_to_primitive_array_component {
        \schemaVar \modalOperator {diamond, box} #normal;
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \varcond(\not \isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                if(#v == null) {
                    throw new java.lang.NullPointerException();
                }
                if (#se < 0 || #se >= @(#length-reference(#v))) {
                    throw new java.lang.ArrayIndexOutOfBoundsException();
                }
                #v[#se]=@(#se0);
                ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    assignment_to_array_component_checked {
        \schemaVar \modalOperator {diamond, box} #normal;
        \find( ==> \modality{#normal}{.. #v[#se]=@(#se0); ...}\endmodality (post))
        \replacewith( ==> {heap := store(heap, #v, arr(#se), #se0)}\modality{#normal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    methodCall {
        \find(\modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality (post))
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \mayExpandMethod(#se, #mn, #selist),
            \not \isThisReference(#se)
        )
        \replacewith(\modality{#allmodal}{..
                if (#se == null) {
                    throw new java.lang.NullPointerException();
                }
                @(#se.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    methodCallWithAssignment {
        \find(\modality{#allmodal}{.. #lhs = #se.#mn(#selist); ...}\endmodality (post))
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \mayExpandMethod(#se, #mn, #selist),
            \not \isThisReference(#se)
        )
        \replacewith(\modality{#allmodal}{..
                if (#se == null) {
                    throw new java.lang.NullPointerException();
                }
                @(#lhs = #se.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    methodCallThis {
        \find(\modality{#allmodal}{.. this.#mn(#selist); ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
                @(this.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    methodCallThisWithAssignment {
        \find(\modality{#allmodal}{.. #lhs = this.#mn(#selist); ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
                @(#lhs = this.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    methodCallWithinClass {
        \find(\modality{#allmodal}{.. #mn(#selist); ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
                @(#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    methodCallWithinClassWithAssignment {
        \find(\modality{#allmodal}{.. #lhs = #mn(#selist); ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
                @(#lhs = #mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    throwUnfold {
        \find(
            \modality{#allmodal}{..
                throw #nse;
            ...}\endmodality (post))
        \varcond(
            \newTypeOf(#v1, #nse),
            \not \isPassiveExpression(#nse)
        )
        \replacewith(\modality{#allmodal}{..
            #typeof(#nse) #v1 = #nse;
            if (#v1 == null) {
                throw new java.lang.NullPointerException();
            }
            throw @(#v1);
              ...}\endmodality (post))

        \heuristics(simplify_prog)
    };

    tryCatchThrow {
        \find(
            \modality{#allmodal}{..
                try {
                    throw #se;
                    #slist
                } catch #cs
            ...}\endmodality (post))

        \replacewith(\modality{#allmodal}{..
              try {
                if (#se == null) {
                    throw new java.lang.NullPointerException();
                }
                throw @(#se);
              } catch #cs
              ...}\endmodality (post))

        \heuristics(simplify_prog)
    };

    tryCatchFinallyThrow {
        \find(\modality{#allmodal}{..
            try {
                throw #se;
                #slist
            }
            catch #cs
            finally {
                #slist1
            }
            ...}\endmodality (post))

        \replacewith(\modality{#allmodal}{..
              try {
                if (#se == null) {
                    throw new java.lang.NullPointerException();
                }
                throw @(#se);
              } catch #cs
              finally {
                #slist1
              }
              ...}\endmodality (post))

        \heuristics(simplify_prog)
    };

    tryCatchFinallyThrowUnfold {
        \find(\modality{#allmodal}{..
            try {
                throw #nse;
                #slist
            }
            catch #cs
            finally {
                #slist1
            }
            ...}\endmodality (post))

        \varcond(
            \newTypeOf(#v1, #nse),
            \not \isPassiveExpression(#nse)
        )
        \replacewith(\modality{#allmodal}{..
              try {
                #typeof(#nse) #v1 = #nse;
                if (#v1 == null) {
                    throw new java.lang.NullPointerException();
                }
                throw @(#v1);
              } catch #cs
              finally {
                #slist1
              }
              ...}\endmodality (post))

        \heuristics(simplify_prog)
    };


    // TODO braucht es rules für mehrere catch-Blöcke?

    // ------------------------------------------------------------------------
    // ----------- Rules for Division and Modulo
    // ------------------------------------------------------------------------

    assignmentDivisionInt {
        \find(\modality{#allmodal}{..
                    #v=#seCharByteShortInt0 / #seCharByteShortInt1;
                ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
            if (#seCharByteShortInt1 == 0) {
                throw new java.lang.ArithmeticException();
            }
            @(#v=#seCharByteShortInt0 / #seCharByteShortInt1);
            ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentDivisionIntChecked {
        \find(\modality{#allmodal}{..
                    @(#v=#seCharByteShortInt0 / #seCharByteShortInt1);
                ...}\endmodality (post))
        \replacewith(
            {#v := javaDivInt(#seCharByteShortInt0, #seCharByteShortInt1)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };


    assignmentDivisionLong {
        \find(\modality{#allmodal}{..
                    #v=#se / #seLong;
                ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
            if (#seLong == 0) {
                throw new java.lang.ArithmeticException();
            }
            @(#v=#se / #seLong);
            ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentDivisionLongChecked {
        \find(\modality{#allmodal}{..
                    @(#v=#se / #seLong);
                ...}\endmodality (post))
        \replacewith(
            {#v := javaDivLong(#se, #seLong)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentDivisionLong2 {
        \find(\modality{#allmodal}{..
                    #v=#seLong / #seCharByteShortInt;
                ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
            if (#seCharByteShortInt == 0) {
                throw new java.lang.ArithmeticException();
            }
            @(#v=#seLong / #seCharByteShortInt);
            ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentDivisionLong2Checked {
        \find(\modality{#allmodal}{..
                    @(#v=#seLong / #seCharByteShortInt);
                ...}\endmodality (post))
        \replacewith(
            {#v := javaDivLong(#seLong, #seCharByteShortInt)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentModulo {
        \find(\modality{#allmodal}{..
                    #v=#se0 % #se1;
                ...}\endmodality (post))
        \replacewith(\modality{#allmodal}{..
            if (#se1 == 0) {
                throw new java.lang.ArithmeticException();
            }
            @(#v=#se0 % #se1);
            ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };

    assignmentModuloChecked {
        \find(\modality{#allmodal}{..
                    @(#v=#se0 % #se1);
                ...}\endmodality (post))
        \replacewith(
            {#v := javaMod(#se0, #se1)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(executeIntegerAssignment)
        \displayname "division"
    };
}