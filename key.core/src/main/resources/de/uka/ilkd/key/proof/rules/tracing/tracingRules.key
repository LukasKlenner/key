\schemaVariables {

    \formula b;

    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, box} #normal;
    \program Type #t;
    \program Expression #e, #e0, #e1, #e2;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program SimpleJavaBooleanExpression #seBool, #seBool0, #seBool1, #seBool2;
    \program NonSimpleExpression #nse, #nse0, #nse1, #nse2;
    \program PassiveExpression #pe;
    \program Statement #s0, #s1, #s2;
    \program LeftHandSide #lhs;
    \program Variable #v, #v0, #v1, #a, #exc;
    \formula post;
    \program JavaIntExpression #catchCount;
    \program ArrayLength #length;
    \program JavaLongExpression #seLong;
    \program JavaCharByteShortIntExpression #seCharByteShortInt, #seCharByteShortInt0, #seCharByteShortInt1;

    \program Label #lb;
    \program Switch #sw;
    \program MethodName #mn;
    \program ExecutionContext #ex;
    \program [list] Expression #elist;
    \program [list] SimpleExpression #selist;
    \program [list] Statement #slist, #slist1, #slist2;
    \program [list] Catch #cs;
}

\rules(programRules:Java, tracing:on) {

    /*
     * Short circuit rules that don't interfere with if/else tracing
     * [they don't translate to if (*) * else *, only to JavaDL \if(*) \then (*) \else (*)]
     */
    compound_assignment_3_nonsimple_new {
        \find(\modality{#allmodal}{.. #lhs=#nse0 && #nse1; ...}\endmodality (post))

        \varcond(\new(#v0, boolean))
        \replacewith(\modality{#allmodal}{.. boolean #v0 = #nse0;
                #lhs = #v0 && #nse1; ...}\endmodality (post))

        \heuristics(simplify_expression)
        \displayname "compound_assignment"
    };

    compound_assignment_3_reverse_mixed {
        \find(\modality{#allmodal}{.. #lhs=#seBool0 && #nse1; ...}\endmodality (post))

        \replacewith(
            \if(#seBool0 = TRUE)
            \then(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
            \else({#lhs := FALSE}\modality{#allmodal}{.. ...}\endmodality (post))
        )

        \heuristics(simplify_expression)
        \displayname "assignment_and"
    };

    compound_assignment_5_nonsimple_new {
        \find(\modality{#allmodal}{.. #lhs=#nse0 || #nse1; ...}\endmodality (post))

        \varcond(\new(#v0, boolean))
        \replacewith(\modality{#allmodal}{.. boolean #v0 = #nse0;
                #lhs = #v0 || #nse1; ...}\endmodality (post))

        \heuristics(simplify_expression)
        \displayname "compound_assignment"
    };

    compound_assignment_5_reverse_mixed {
        \find(\modality{#allmodal}{.. #lhs=#seBool0 || #nse1; ...}\endmodality (post))

        \replacewith(
            \if(#seBool0 = TRUE)
            \then({#lhs := TRUE}\modality{#allmodal}{.. ...}\endmodality (post))
            \else(\modality{#allmodal}{.. #lhs = #nse1; ...}\endmodality (post))
        )

        \heuristics(simplify_expression)
        \displayname "assignment_or"
    };

    // ------------------------------------------------------------------------
    // ----------- Ternary Operator Rules
    // ------------------------------------------------------------------------

    ternary_unfold {
        \find(\modality{#allmodal}{.. #lhs = #e0 ? #e1 : #e2; ...}\endmodality (post))
        \varcond(\newTypeOf(#v1, #e0))
        \replacewith(\modality{#allmodal}{..
                #typeof(#e0) #v1 = #e0;
                #lhs = #v1 ? #e1 : #e2;
            ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "ternary_unfold"
    };

    ternary_true_traced {
        \find(\modality{#allmodal}{.. #lhs = #se ? #e1 : #e2; ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{.. #lhs = #e1; ...}\endmodality (post))
        \add(#se = TRUE ==>)
        \heuristics(simplify_prog)
        \advanceTrace(1)
        \displayname "ternary_true_traced"
    };

    ternary_false_traced {
        \find(\modality{#allmodal}{.. #lhs = #se ? #e1 : #e2; ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(\modality{#allmodal}{.. #lhs = #e2; ...}\endmodality (post))
        \add(#se = FALSE ==>)
        \heuristics(simplify_prog)
        \advanceTrace(1)
        \displayname "ternary_false_traced"
    };

    // ------------------------------------------------------------------------
    // ----------- Write Attributes Rules
    // ------------------------------------------------------------------------

    // Write attribute
    // O = not null
    assignment_write_attribute_traced {
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \tracePattern("O")
        \varcond(
            \not \static(#a), 
            \not \isThisReference(#v), 
            \not \isUntracedField(#a))
        \replacewith( ==> {heap := store(heap, #v, #memberPVToField(#a), #se)}\modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#v = null) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
        \displayname "assignment"
    };

    // I = null
    assignment_write_attribute_traced_null {
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \tracePattern("I")
        \varcond(
            \not \static(#a), 
            \not \isThisReference(#v), 
            \not \isUntracedField(#a))
        \replacewith( ==> \modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
        \displayname "assignment"
    };

    // Untraced field ($-prefixed): no NPE check, no trace consumed
    assignment_write_attribute_untraced {
        \find( ==> \modality{#allmodal}{.. #v.#a=#se; ...}\endmodality (post))
        \varcond(
            \not \static(#a), 
            \not \isThisReference(#v), 
            \isUntracedField(#a)
        )
        \replacewith( ==> {heap := store(heap, #v, #memberPVToField(#a), #se)}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assignment"
    };

    // ------------------------------------------------------------------------
    // ----------- Read Attribute Rules
    // ------------------------------------------------------------------------

    // O = not null
    assignment_read_attribute_traced {
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post))
        \tracePattern("O")
        \varcond(
            \hasElementarySort(#v0, G),
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isThisReference(#v),
            \not \isUntracedField(#a))
        \replacewith( ==> {#v0 := select<[G]>(heap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#v = null) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };

    // I = null
    assignment_read_attribute_traced_null {
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post))
        \tracePattern("I")
        \varcond(
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isThisReference(#v),
            \not \isUntracedField(#a))
        \replacewith( ==> \modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
        ...}\endmodality (post))
        \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };

    // Untraced field ($-prefixed)
    assignment_read_attribute_untraced {
        \find( ==> \modality{#allmodal}{.. #v0 = #v.#a; ...}\endmodality (post))
        \varcond(
            \hasElementarySort(#v0, G),
            \not \static(#a),
            \not \isArrayLength(#a),
            \not \isThisReference(#v),
            \isUntracedField(#a))
        \replacewith( ==> {#v0 := select<[G]>(heap, #v, #memberPVToField(#a))}\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    // ------------------------------------------------------------------------
    // ----------- Read Array Length Rules
    // ------------------------------------------------------------------------

    // O = not null
    assignment_read_length_traced {
        \find(\modality{#allmodal}{.. #v0 = #v.#length; ...}\endmodality (post))
        \tracePattern("O")
        \varcond(\not \isThisReference(#v))
        \replacewith({#v0 := length(#v)}\modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#v = null) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };

    // I = null
    assignment_read_length_traced_null {
        \find(\modality{#allmodal}{.. #v0 = #v.#length; ...}\endmodality (post))
        \tracePattern("I")
        \varcond(\not \isThisReference(#v))
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
        ...}\endmodality (post))
        \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };


    // ------------------------------------------------------------------------
    // ----------- Array Read Rules
    // ------------------------------------------------------------------------

    // I = null
    assignment_array2_traced_null {
          \find(\modality{#allmodal}{.. #v = #v0[#se]; ...}\endmodality (post))
          \tracePattern("I")
          \varcond(\hasElementarySort(#v0, G))
          \replacewith(\modality{#allmodal}{..
                  throw @(new java.lang.NullPointerException());
                  ...}\endmodality (post))
          \add(#v0 = null ==>)
          \heuristics(simplify_prog, simplify_prog_subset)
          \advanceTrace(1)
    };

    // OI = not null, out of bounds
    assignment_array2__traced_oob {
          \find(\modality{#allmodal}{.. #v = #v0[#se]; ...}\endmodality (post))
          \tracePattern("OI")
          \varcond(\hasElementarySort(#v0, G))
          \replacewith(\modality{#allmodal}{..
                  throw @(new java.lang.ArrayIndexOutOfBoundsException());
                  ...}\endmodality (post))
          \add(!(#v0 = null) & (#se < 0 | #se >= length(#v0)) ==>)
          \heuristics(simplify_prog, simplify_prog_subset)
          \advanceTrace(2)
    };

    // OO = not null, in bounds
    assignment_array2_traced {
          \find(\modality{#allmodal}{.. #v = #v0[#se]; ...}\endmodality (post))
          \tracePattern("OO")
          \varcond(\hasElementarySort(#v0, G))
          \replacewith({#v := select<[G]>(heap, #v0, arr(#se))}\modality{#allmodal}{.. ...}\endmodality (post))
          \add(!(#v0 = null) & !(#se < 0) & #se < length(#v0) ==>)
          \heuristics(simplify_prog, simplify_prog_subset)
          \advanceTrace(2)
    };

    // ------------------------------------------------------------------------
    // ----------- Reference Array Write Rules
    // ------------------------------------------------------------------------

    // I = null
    assignment_to_reference_array_component_traced_null {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("I")
        \varcond(\isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };

    // OI = not null, out of bounds
    assignment_to_reference_array_component_traced_oob {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("OI")
        \varcond(\isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                throw @(new java.lang.ArrayIndexOutOfBoundsException());
                ...}\endmodality (post))
        \add(!(#v = null) & (#se < 0 | #se >= length(#v)) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(2)
    };

    // OOI = not null, in bounds, store exception
    assignment_to_reference_array_component_traced_storeExc {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("OOI")
        \varcond(\isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                throw @(new java.lang.ArrayStoreException());
                ...}\endmodality (post))
        \add(!(#v = null) & !(#se < 0) & #se < length(#v) & !arrayStoreValid(#v, #se0) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(3)
    };

    // OOO = not null, in bounds, no store exception
    assignment_to_reference_array_component_traced {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("OOO")
        \varcond(\isReferenceArray(#v))
        \replacewith( ==> {heap := store(heap, #v, arr(#se), #se0)}\modality{#normal}{.. ...}\endmodality (post))
        \add(!(#v = null) & !(#se < 0) & #se < length(#v) & arrayStoreValid(#v, #se0) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(3)
    };

    // ------------------------------------------------------------------------
    // ----------- Primitive Array Write Rules
    // ------------------------------------------------------------------------

    // I = null
    assignment_to_primitive_array_component_traced_null {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("I")
        \varcond(\not \isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \add(#v = null ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(1)
    };

    // OI = not null, out of bounds
    assignment_to_primitive_array_component_traced_oob {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("OI")
        \varcond(\not \isReferenceArray(#v))
        \replacewith( ==> \modality{#normal}{..
                throw @(new java.lang.ArrayIndexOutOfBoundsException());
                ...}\endmodality (post))
        \add(!(#v = null) & (#se < 0 | #se >= length(#v)) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(2)
    };

    // OO = not null, in bounds
    assignment_to_primitive_array_component_traced {
        \find( ==> \modality{#normal}{.. #v[#se]=#se0; ...}\endmodality (post))
        \tracePattern("OO")
        \varcond(\not \isReferenceArray(#v))
        \replacewith( ==> {heap := store(heap, #v, arr(#se), #se0)}\modality{#normal}{.. ...}\endmodality (post))
        \add(!(#v = null) & !(#se < 0) & #se < length(#v) ==>)
        \heuristics(simplify_prog, simplify_prog_subset)
        \advanceTrace(2)
    };

    // ------------------------------------------------------------------------
    // ----------- Throw Rules
    // Problems when handling throw statements:
    // - Exceptions might not be directly be catched by a try-catch block, but might be propagated to a higher level
    // - The next trace element might not directly be the catch element because of finally blocks of try blocks that do not catch the exception
    //   -> We do nullness checks for throw statements eagerly (including null-check)
    //   -> use passive expression ("throw @(#se)") to mark already checked exceptions
    //      -> Taclets that create throw statements for implicit exceptions (e.g. NPE) create passive expressions
    //   -> We try to eagerly consume the catch trace element to avoid conflicts with finally blocks
    //      - TracingStates stores last consumed catch element
    //      - stored catch index is reset once used by #traced-throw
    //      - #traced-throw is only used when the next trace element is not a catch
    // ------------------------------------------------------------------------

    // don't unfold passive expressions
    throwUnfold {
        \find(
            \modality{#allmodal}{..
                throw #nse;
            ...}\endmodality (post))
        \tracePattern("*")
        \varcond(
            \newTypeOf(#v1, #nse),
            \not \isPassiveExpression(#nse)
        )
        \replacewith(\modality{#allmodal}{..
                #typeof(#nse) #v1 = #nse;
                throw #v1;
              ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    // --- Rules for null-checking. Checked throw statements are marked with a passive expression

    throw_null_check {
        \find(
            \modality{#allmodal}{..
                throw #se;
            ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
              ...}\endmodality (post))
        \add(#se = null ==>)
        \heuristics(simplify_prog)
        \advanceTrace(2)
    };

    throw_not_null_check {
        \find(
            \modality{#allmodal}{..
                throw #se;
            ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(\modality{#allmodal}{..
            throw @(#se);
              ...}\endmodality (post))
        \add(!(#se = null) ==>)
        \heuristics(simplify_prog)
        \advanceTrace(2)
    };

    // Try to eagerly consume the catch trace element to avoid conflicts with finally blocks
    throw_consume_trace_catch_element {
        \find(
            \modality{#allmodal}{..
                throw @(#e);
            ...}\endmodality (post))
        \tracePattern("J")
        \replacewith(\modality{#allmodal}{..
                throw @(#e);
              ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(1)
        \displayname "throw_consume_trace_catch_element"
    };

    // --- Rules for handling try-catch blocks. 
    // We only use them when the next trace element is not a catch:
    // - If the next element is a catch it is first consumed by throw_consume_trace_catch_element
    //   - The next trace element will not be a catch because two catch elements cannot be consecutive in a trace
    // - If the next element is not a catch, the catch element has either already been properly consumed or
    //     it is not yet relevant because a finally block will be executed first

    try_catch_throw_traced {
        \find(
            \modality{#allmodal}{..
                try {
                    throw @(#e);
                    #slist
                } catch #cs
            ...}\endmodality (post))
        \tracePattern("!J")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{..
              #traced-throw(#cs, #e);
              ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
    };

    try_catch_finally_throw_traced {
        \find(\modality{#allmodal}{..
            try {
                throw @(#e);
                #slist
            }
            catch #cs
            finally {
                #slist1
            }
            ...}\endmodality (post))
        \tracePattern("!J")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{..
              #traced-throw(#cs, #slist1, #e);
              ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
    };

    try_finally_throw_propagated {
        \find(\modality{#allmodal}{..
            try {
                throw @(#se);
            }
            finally {
                #slist1
            }
            ...}\endmodality (post))
        \varcond(\newTypeOf(#v0, #se))
        \replacewith(\modality{#allmodal}{..
                     #typeof(#se) #v0 = #se;
                     { #slist1 }
                     throw @(#v0);
              ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    // --- Rules for propagating throw statements without try-catch blocks

    methodCallThrowPassive {
        \find(\modality{#allmodal}{.. method-frame(#ex):{throw #pe; #slist} ...}\endmodality (post))
        \varcond(\isLocalVariable(#se))
        \replacewith(\modality{#allmodal}{.. throw #pe; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "methodCallThrow"
    };

    methodCallParamThrowPassive {
        \find(\modality{#allmodal}{.. method-frame(#v0, #ex){throw #pe; #slist}
                ...}\endmodality (post))
        \varcond(\isLocalVariable(#se))
        \replacewith(\modality{#allmodal}{.. throw #pe; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "methodCallThrow"
    };

    // --- Rules for try blocks without throw -> only advance catch count

    tryEmpty {
        \find(\modality{#allmodal}{.. try {} catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
    };

    tryFinallyEmpty {
        \find(\modality{#allmodal}{.. try {}
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 }  ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryEmpty"
    };

    tryBreakLabel {
        \find(\modality{#allmodal}{.. try { break #lb; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. break #lb; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryBreak"
    };

    tryFinallyBreakLabel {
        \find(\modality{#allmodal}{.. try { break #lb; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 } break #lb; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryBreak"
    };

    tryBreak {
        \find(\modality{#allmodal}{.. try { break; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. break; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryBreak"
    };

    tryFinallyBreak {
        \find(\modality{#allmodal}{.. try { break; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 } break; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryBreak"
    };

    try_continue_1 {
        \find(\modality{#allmodal}{.. try { continue #lb; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. continue #lb; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "try_continue"
    };

    try_finally_continue_1 {
        \find(\modality{#allmodal}{.. try { continue #lb; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 } continue #lb; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "try_continue"
    };

    try_continue_2 {
        \find(\modality{#allmodal}{.. try { continue; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. continue; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "try_continue"
    };

    try_finally_continue_2 {
        \find(\modality{#allmodal}{.. try { continue; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 } continue; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "try_continue"
    };

    tryReturn {
        \find(\modality{#allmodal}{.. try { return #se; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. return #se; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryReturn"
    };

    tryFinallyReturn {
        \find(\modality{#allmodal}{.. try { return #se; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\newTypeOf(#v0, #se), \catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. #typeof(#se) #v0 = #se;
                { #slist2 }
                return #v0; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryReturn"
    };

    tryReturnNoValue {
        \find(\modality{#allmodal}{.. try { return; #slist }
                catch #cs ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. return; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryReturn"
    };

    tryFinallyReturnNoValue {
        \find(\modality{#allmodal}{.. try { return; #slist }
                catch #cs
                finally { #slist2 } ...}\endmodality (post))
        \tracePattern("*")
        \varcond(\catchCount(#catchCount, #cs))
        \replacewith(\modality{#allmodal}{.. { #slist2 } return; ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(0, #catchCount)
        \displayname "tryReturn"
    };

    // ------------------------------------------------------------------------
    // ----------- Division and Modulo Rules
    // ------------------------------------------------------------------------

    // Division int: div-by-zero check
    assignmentDivisionInt_traced {
        \find(\modality{#allmodal}{..
                    #v=#seCharByteShortInt0 / #seCharByteShortInt1;
                ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(
            {#v := javaDivInt(#seCharByteShortInt0, #seCharByteShortInt1)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#seCharByteShortInt1 = 0) ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    assignmentDivisionInt_exc_traced {
        \find(\modality{#allmodal}{..
                    #v=#seCharByteShortInt0 / #seCharByteShortInt1;
                ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.ArithmeticException());
                ...}\endmodality (post))
        \add(#seCharByteShortInt1 = 0 ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    // Division long (se / seLong): div-by-zero check
    assignmentDivisionLong_traced {
        \find(\modality{#allmodal}{..
                    #v=#se / #seLong;
                ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(
            {#v := javaDivLong(#se, #seLong)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#seLong = 0) ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    assignmentDivisionLong_exc_traced {
        \find(\modality{#allmodal}{..
                    #v=#se / #seLong;
                ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.ArithmeticException());
                ...}\endmodality (post))
        \add(#seLong = 0 ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    // Division long2 (seLong / seCharByteShortInt): div-by-zero check
    assignmentDivisionLong2_traced {
        \find(\modality{#allmodal}{..
                    #v=#seLong / #seCharByteShortInt;
                ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(
            {#v := javaDivLong(#seLong, #seCharByteShortInt)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#seCharByteShortInt = 0) ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    assignmentDivisionLong2_exc_traced {
        \find(\modality{#allmodal}{..
                    #v=#seLong / #seCharByteShortInt;
                ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.ArithmeticException());
                ...}\endmodality (post))
        \add(#seCharByteShortInt = 0 ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    // Modulo: div-by-zero check
    assignmentModulo_traced {
        \find(\modality{#allmodal}{..
                    #v=#se0 % #se1;
                ...}\endmodality (post))
        \tracePattern("O")
        \replacewith(
            {#v := javaMod(#se0, #se1)}
            \modality{#allmodal}{.. ...}\endmodality (post))
        \add(!(#se1 = 0) ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    assignmentModulo_exc_traced {
        \find(\modality{#allmodal}{..
                    #v=#se0 % #se1;
                ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.ArithmeticException());
                ...}\endmodality (post))
        \add(#se1 = 0 ==>)
        \heuristics(executeIntegerAssignment)
        \advanceTrace(1)
        \displayname "division"
    };

    // ------------------------------------------------------------------------
    // ----------- If Rules
    // ------------------------------------------------------------------------

    // Succedent, with else branch
    if_else_true_traced {
        \find( ==> \modality{#allmodal}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
        \tracePattern("I")
        \replacewith( ==> \modality{#allmodal}{.. #s0 ...}\endmodality (post))
        \add(#se = TRUE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfThen"
    };

    if_else_false_traced {
        \find( ==> \modality{#allmodal}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
        \tracePattern("O")
        \replacewith( ==> \modality{#allmodal}{.. #s1 ...}\endmodality (post))
        \add(#se = FALSE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfElse"
    };

    // Succedent, no else branch
    if_true_traced {
        \find( ==> \modality{#allmodal}{.. if(#se) #s0 ...}\endmodality (post))
        \tracePattern("I")
        \replacewith( ==> \modality{#allmodal}{.. #s0 ...}\endmodality (post))
        \add(#se = TRUE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfThen"
    };

    if_false_traced {
        \find( ==> \modality{#allmodal}{.. if(#se) #s0 ...}\endmodality (post))
        \tracePattern("O")
        \replacewith( ==> \modality{#allmodal}{.. ...}\endmodality (post))
        \add(#se = FALSE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfElse"
    };

    // Antecedent, with else branch
    if_else_true_left_traced {
        \find(\modality{#allmodal}{.. if(#se) #s0 else #s1 ...}\endmodality (post) ==>)
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{.. #s0 ...}\endmodality (post) ==>)
        \add(#se = TRUE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfThen"
    };

    if_else_false_left_traced {
        \find(\modality{#allmodal}{.. if(#se) #s0 else #s1 ...}\endmodality (post) ==>)
        \tracePattern("O")
        \replacewith(\modality{#allmodal}{.. #s1 ...}\endmodality (post) ==>)
        \add(#se = FALSE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfElse"
    };

    // Antecedent, no else branch
    if_true_left_traced {
        \find(\modality{#allmodal}{.. if(#se) #s0 ...}\endmodality (post) ==>)
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{.. #s0 ...}\endmodality (post) ==>)
        \add(#se = TRUE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfThen"
    };

    if_false_left_traced {
        \find(\modality{#allmodal}{.. if(#se) #s0 ...}\endmodality (post) ==>)
        \tracePattern("O")
        \replacewith(\modality{#allmodal}{.. ...}\endmodality (post) ==>)
        \add(#se = FALSE ==>)
        \heuristics(split_if)
        \advanceTrace(1)
        \displayname "traceIfElse"
    };

    // ------------------------------------------------------------------------
    // ----------- Close Rules
    // ------------------------------------------------------------------------

    close {
        \assumes(b ==>)
        \find( ==> b)
        \tracePattern("E")
        \closegoal
        \heuristics(closure)
        \advanceTrace(1)
        \displayname "close"
    };
    closeAntec {
        \assumes( ==> b)
        \find(b ==>)
        \tracePattern("E")
        \closegoal
        \heuristics(closure)
        \advanceTrace(1)
        \displayname "close"
    };

    closeFalse {
        \find(false ==>)
        \tracePattern("E")
        \closegoal
        \heuristics(closure)
        \advanceTrace(1)
    };
    closeTrue {
        \find( ==> true)
        \tracePattern("E")
        \closegoal
        \heuristics(closure)
        \advanceTrace(1)
    };

    // ------------------------------------------------------------------------
    // ----------- Method Call Rules
    // ------------------------------------------------------------------------

    // --- Traced obj.method() calls (NPE check + dispatch in one step) ---

    // OC = not null, dispatch via trace
    method_call_traced {
        \find(\modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality (post))
        \tracePattern("OC")
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \not \isUntracedMethod(#se, #mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                #traced-method-call(#se.#mn(#selist));
                ...}\endmodality (post))
        \add(!(#se = null) ==>)
        \heuristics(method_expand)
        \advanceTrace(2)
        \displayname "tracedMethodCall"
    };

    // I = null
    method_call_null_traced {
        \find(\modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality (post))
        \tracePattern("I")
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \not \isUntracedMethod(#se, #mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \add(#se = null ==>)
        \heuristics(method_expand)
        \advanceTrace(1)
        \displayname "tracedMethodCallNull"
    };

    // WithAssignment: OC = not null, dispatch via trace
    method_call_with_assignment_traced {
        \find(\modality{#allmodal}{.. #lhs = #se.#mn(#selist); ...}\endmodality (post))
        \tracePattern("OC")
        \varcond(
            \newTypeOf(#v0, #lhs),
            \not \staticMethodReference(#se, #mn, #selist),
            \not \isUntracedMethod(#se, #mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #traced-method-call(#v0, #se.#mn(#selist));
                #lhs = #v0;
                ...}\endmodality (post))
        \add(!(#se = null) ==>)
        \heuristics(method_expand)
        \advanceTrace(2)
        \displayname "tracedMethodCall"
    };

    // WithAssignment: I = null
    method_call_with_assignment_null_traced {
        \find(\modality{#allmodal}{.. #lhs = #se.#mn(#selist); ...}\endmodality (post))
        \tracePattern("I")
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \not \isUntracedMethod(#se, #mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \add(#se = null ==>)
        \heuristics(method_expand)
        \advanceTrace(1)
        \displayname "tracedMethodCallNull"
    };

    // --- Untraced obj.method() calls (private/static/$-prefixed on expression receiver) ---

    method_call_untraced {
        \find(\modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality (post))
        \varcond(
            \not \staticMethodReference(#se, #mn, #selist),
            \isUntracedMethod(#se, #mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #method-call(#se.#mn(#selist));
                ...}\endmodality (post))
        \heuristics(method_expand)
        \displayname "methodCall"
    };

    method_call_untraced_with_assignment {
        \find(\modality{#allmodal}{.. #lhs = #se.#mn(#selist); ...}\endmodality (post))
        \varcond(
            \newTypeOf(#v0, #lhs),
            \not \staticMethodReference(#se, #mn, #selist),
            \isUntracedMethod(#se, #mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #method-call(#v0, #se.#mn(#selist));
                #lhs = #v0;
                ...}\endmodality (post))
        \heuristics(method_expand)
        \displayname "methodCall"
    };

    // --- Within-class call taclets ---

    method_call_within_class_traced {
        \find(\modality{#allmodal}{.#ex.. #mn(#selist); ...}\endmodality (post))
        \tracePattern("C")
        \varcond(\not \isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #traced-method-call(#ex, #mn(#selist));
                ...}\endmodality (post))
        \heuristics(method_expand)
        \advanceTrace(1)
        \displayname "tracedMethodCall"
    };

    method_call_with_assignment_within_class_traced {
        \find(\modality{#allmodal}{.#ex.. #lhs = #mn(#selist); ...}\endmodality (post))
        \tracePattern("C")
        \varcond(
            \newTypeOf(#v0, #lhs),
            \not \isUntracedMethod(#mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #traced-method-call(#ex, #v0, #mn(#selist));
                #lhs = #v0;
                ...}\endmodality (post))
        \heuristics(method_expand)
        \advanceTrace(1)
        \displayname "tracedMethodCall"
    };

    method_call_within_class_untraced {
        \find(\modality{#allmodal}{.#ex.. #mn(#selist); ...}\endmodality (post))
        \varcond(\isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #method-call(#ex, #mn(#selist));
                ...}\endmodality (post))
        \heuristics(method_expand)
        \displayname "methodCall"
    };

    method_call_untraced_with_assignment_within_class {
        \find(\modality{#allmodal}{.#ex.. #lhs = #mn(#selist); ...}\endmodality (post))
        \varcond(\newTypeOf(#v0, #lhs), \isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #method-call(#ex, #v0, #mn(#selist));
                #lhs = #v0;
                ...}\endmodality (post))
        \heuristics(method_expand)
        \displayname "methodCall"
    };


    // --- this call taclets ---

    method_call_this_traced {
        \find(\modality{#allmodal}{.. this.#mn(#selist); ...}\endmodality (post))
        \tracePattern("C")
        \varcond(\not \isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #traced-method-call(this.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
        \advanceTrace(1)
    };

    method_call_this_with_assignment_traced {
        \find(\modality{#allmodal}{.. #lhs = this.#mn(#selist); ...}\endmodality (post))
        \tracePattern("C")
        \varcond(
            \newTypeOf(#v0, #lhs),
            \not \isUntracedMethod(#mn, #selist)
        )
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #traced-method-call(#v0, this.#mn(#selist));
                #lhs = #v0;
         ...}\endmodality (post))
        \heuristics(method_expand)
        \advanceTrace(1)
    };

    method_call_this_untraced {
        \find(\modality{#allmodal}{.. this.#mn(#selist); ...}\endmodality (post))
        \varcond(\isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #method-call(this.#mn(#selist));
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    method_call_this_untraced_with_assignment {
        \find(\modality{#allmodal}{.. #lhs = this.#mn(#selist); ...}\endmodality (post))
        \varcond(\newTypeOf(#v0, #lhs), \isUntracedMethod(#mn, #selist))
        \replacewith(\modality{#allmodal}{..
                #typeof(#lhs) #v0;
                #method-call(#v0, this.#mn(#selist));
                #lhs = #v0;
         ...}\endmodality (post))
        \heuristics(method_expand)
    };

    // ------------------------------------------------------------------------
    // ----------- Switch Rules
    // ------------------------------------------------------------------------

    switch_traced {
        \find(\modality{#allmodal}{.. #sw ...}\endmodality (post))
        \tracePattern("OS")
        \replacewith(\modality{#allmodal}{..
                #traced-switch-statement(#sw);
                ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(7)
    };

    switch_null_traced {
        \find(\modality{#allmodal}{.. #sw ...}\endmodality (post))
        \tracePattern("I")
        \replacewith(\modality{#allmodal}{..
                throw @(new java.lang.NullPointerException());
                ...}\endmodality (post))
        \heuristics(simplify_prog)
        \advanceTrace(1)
    };

}